                     <children>
                        <Label fx:id="boardName" maxHeight="-Infinity" minHeight="-Infinity" minWidth="200.0" prefHeight="34.0" prefWidth="544.0" textAlignment="RIGHT">
                           <font>
                              <Font name="Arial Bold" size="18.0" />
                           </font>
                           <padding>
                              <Insets left="20.0" />
                           </padding>
                        </Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" blendMode="DARKEN" fillHeight="false" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="47.0" scaleShape="false" style="-fx-background-color: #B3D1C5;" AnchorPane.rightAnchor="0.0">
                     <children>
                        <Line endY="20.0" strokeWidth="0.25">
                           <HBox.margin>
                              <Insets right="15.0" />
                           </HBox.margin>
                        </Line>
                        <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefWidth="70.0" styleClass="green-button" text="Rename">
                           <HBox.margin>
                              <Insets right="15.0" />
                           </HBox.margin>
                           <font>
                              <Font name="Arial Bold" size="12.0" />
                           </font>
                        </Button>
                        <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefWidth="70.0" styleClass="green-button" text="Add list">
                           <font>
                              <Font name="Arial Bold" size="12.0" />
                           </font>
                        </Button>
                        <Line endY="20.0" strokeWidth="0.25">
                           <HBox.margin>
                              <Insets left="15.0" right="15.0" />
                           </HBox.margin>
                        </Line>
                        <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#deleteBoard" prefWidth="70.0" styleClass="red-button" text="Delete">
                           <font>
                              <Font name="Arial Bold" size="12.0" />
                           </font>
                           <HBox.margin>
                              <Insets right="15.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
                  <ScrollPane layoutY="45.0" prefHeight="502.0" prefWidth="822.0" style="-fx-background: F8FEFB;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="47.0">
                     <content>
                        <HBox fx:id="listContainer" prefHeight="450.0" prefWidth="820.0" spacing="30.0" style="-fx-background-color: F8FEFB;">
                           <padding>
                              <Insets left="20.0" right="20.0" top="20.0" />
                           </padding></HBox>
                     </content>
                  </ScrollPane>
               </children>
            </AnchorPane>
         </center>
      </BorderPane>
