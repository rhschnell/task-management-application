<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<AnchorPane fx:id="pane" onMouseClicked="#click" prefHeight="40.0" prefWidth="298.0" styleClass="card" stylesheets="/client/style/stylesheet.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.windows.lists.cells.CardCtrl">
   <children>
      <HBox alignment="CENTER" layoutX="-2.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="-2.0" AnchorPane.rightAnchor="2.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox prefHeight="44.0" prefWidth="500.0" spacing="10.0">
               <children>
                    <HBox alignment="CENTER_LEFT" minWidth="165.0" spacing="5.0">
                         <Label fx:id="cardTitle" contentDisplay="TOP" prefHeight="40.0" prefWidth="241.0" text="Text" wrapText="true">
                        <font>
                           <Font name="Arial Bold" size="14.0" />
                        </font>
                        <opaqueInsets>
                           <Insets />
                        </opaqueInsets>
                     </Label>
                     <ImageView fx:id="descriptionIcon" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                         <image>
                             <Image url="/client/icons/description.png"/>
                         </image>
                     </ImageView>
                    </HBox>
                  <HBox>
                     <children>
                        <HBox prefHeight="16.0" spacing="5.0">
                           <children>
                              <Circle fx:id="tagCircle1" fill="WHITE" radius="7.0" stroke="BLACK" strokeType="INSIDE" />
                              <Circle fx:id="tagCircle2" fill="WHITE" radius="7.0" stroke="BLACK" strokeType="INSIDE" />
                              <Circle fx:id="tagCircle3" fill="WHITE" radius="7.0" stroke="BLACK" strokeType="INSIDE" />
                           </children>
                        </HBox>
                        <Label fx:id="subtaskIndicator" alignment="CENTER_RIGHT" contentDisplay="TOP" minWidth="30.0" prefHeight="16.0" prefWidth="327.0" text="Text" visible="false" wrapText="true" HBox.hgrow="ALWAYS">
                           <font>
                              <Font name="Arial" size="13.0" />
                           </font>
                           <opaqueInsets>
                              <Insets />
                           </opaqueInsets>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="50.0" prefWidth="0.0" />
            <VBox prefHeight="44.0" spacing="8.0">
               <children>
                  <ImageView fx:id="editButton" fitHeight="18.0" onMouseClicked="#edit" pickOnBounds="true" preserveRatio="true">
                      <image>
                          <Image url="/client/icons/pencil-alt.png" />
                      </image>
                  </ImageView>
                  <ImageView fx:id="deleteButton" fitWidth="18.0" onMouseClicked="#delete" pickOnBounds="true" preserveRatio="true">
                      <image>
                          <Image url="/client/icons/trash-can.png" />
                      </image>
                  </ImageView>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </children>
</AnchorPane>
