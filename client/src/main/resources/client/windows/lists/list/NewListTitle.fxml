<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane prefHeight="107.0" prefWidth="332.0" stylesheets="/client/style/stylesheet.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.windows.lists.list.NewListNameCtrl">
    <children>
        <Button layoutX="14.0" layoutY="64.0" mnemonicParsing="false" onMouseClicked="#cancel"
                prefHeight="25.0" prefWidth="88.0" styleClass="red-button" text="Cancel" />
        <Button layoutX="230.0" layoutY="64.0" mnemonicParsing="false" onMouseClicked="#create"
                prefHeight="25.0" prefWidth="88.0" styleClass="blue-button" text="Create" />
        <TextField fx:id="listTitleField" layoutX="15.0" layoutY="14.0" onKeyPressed="#handleKeyEvents" prefHeight="39.0" prefWidth="304.0" promptText="New List Name" style="-fx-background-radius: 10;" />
    </children>
</AnchorPane>
