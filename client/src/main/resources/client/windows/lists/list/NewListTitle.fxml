<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="80.0" prefWidth="257.0" stylesheets="/client/style/stylesheet.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.windows.lists.list.NewListNameCtrl">
   <children>
      <Button layoutX="159.0" layoutY="52.0" mnemonicParsing="false" onMouseClicked="#cancel" prefHeight="23.0" prefWidth="61.0" styleClass="red-button" text="Cancel" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </Button>
      <Button layoutX="10.0" layoutY="52.0" mnemonicParsing="false" onMouseClicked="#create" prefHeight="23.0" prefWidth="61.0" styleClass="blue-button" text="Save" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </Button>
      <TextField fx:id="listTitleField" layoutX="13.0" layoutY="18.0" onKeyPressed="#handleKeyEvents" prefHeight="25.0" prefWidth="237.0" promptText="New list title" style="-fx-background-radius: 10;" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <font>
            <Font size="12.0" />
         </font>
      </TextField>
   </children>
</AnchorPane>
