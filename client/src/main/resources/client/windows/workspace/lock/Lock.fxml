<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="76.0" prefWidth="276.0" stylesheets="/client/style/stylesheet.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.windows.workspace.lock.LockPopUpCtrl">
   <children>
      <HBox layoutX="7.0" layoutY="44.0" prefHeight="24.0" prefWidth="262.0">
         <children>
             <Button mnemonicParsing="false" onMouseClicked="#confirm" prefHeight="23.0" prefWidth="76.0" styleClass="blue-button" text="Confirm">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <Label fx:id="errorMsg" prefHeight="24.0" prefWidth="98.0" text="Incorrect password" textFill="RED" visible="false">
               <font>
                  <Font name="System Italic" size="12.0" />
               </font>
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
            </Label>
             <Button mnemonicParsing="false" onMouseClicked="#cancel" prefHeight="23.0" prefWidth="70.0" styleClass="red-button" text="Cancel">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
       <PasswordField fx:id="inputField" layoutX="8.0" layoutY="9.0" prefHeight="25.0" prefWidth="261.0" promptText="Password" style="-fx-background-radius: 10;" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="7.0" AnchorPane.topAnchor="9.0" />
   </children>
</AnchorPane>
