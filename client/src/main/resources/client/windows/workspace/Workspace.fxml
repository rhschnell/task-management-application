      <VBox fx:id="boardControls" alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="548.0" prefWidth="170.0" spacing="10.0" style="-fx-effect: dropshadow( three-pass-box , gray, 2, 0.0 , -1, 0); -fx-background-color: ACC7BB;">
