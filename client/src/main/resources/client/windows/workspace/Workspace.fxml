<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="549.0" prefWidth="1025.0" style="-fx-background-color: F6F6F6;" stylesheets="/client/style/stylesheet.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.windows.workspace.boardSpace.WorkspaceCtrl">
   <center>
      <VBox>
         <children>
            <HBox fx:id="titleBar" fillHeight="false" prefHeight="47.0" prefWidth="820.0" spacing="15.0" style="-fx-background-color: B7CEC4;">
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
               <children>
                  <Label fx:id="boardName" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefHeight="34.0" prefWidth="1276.0" textAlignment="RIGHT" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Arial Bold" size="18.0" />
                     </font>
                  </Label>
                  <Button fx:id="unlockBoardButton" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#unlock" prefHeight="30.0" prefWidth="70.0" styleClass="green-button" text="Unlock">
                     <font>
                        <Font name="Arial Bold" size="12.0" />
                     </font>
                  </Button>
                  <Button fx:id="addListButton" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#addList" prefHeight="30.0" prefWidth="87.0" styleClass="green-button" text="Add list">
                     <font>
                        <Font name="Arial Bold" size="12.0" />
                     </font>
                     <graphic>
                        <ImageView fitHeight="13.0" fitWidth="13.0" nodeOrientation="RIGHT_TO_LEFT" onMouseClicked="#addList" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="/client/icons/white-plus.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" focusTraversable="false" prefHeight="502.0" prefWidth="822.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <HBox fx:id="listContainer" prefHeight="450.0" prefWidth="820.0" spacing="30.0" style="-fx-background-color: transparent;">
                  <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
               </HBox>
            </ScrollPane>
         </children>
      </VBox>
   </center>
   <left>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="239.0" prefWidth="231.0" spacing="10.0" style="-fx-effect: dropshadow( three-pass-box , gray, 2, 0.0 , 1, 0); -fx-background-color: ACC7BB;">
         <opaqueInsets>
            <Insets />
