               <graphic>
                  <ImageView fitHeight="21.0" fitWidth="17.0" onMouseClicked="#leaveBoard" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="/client/icons/users.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
            <Button fx:id="copyButton" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#copyKey" prefHeight="30.0" prefWidth="85.0" styleClass="green-button" text="Copy Key">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <Separator prefWidth="200.0" />
            <Label maxHeight="-Infinity" minHeight="-Infinity" prefHeight="21.0" prefWidth="231.0" text="Password" textAlignment="CENTER">
               <font>
                  <Font name="Arial Bold" size="14.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="14.0" fitWidth="14.0" onMouseClicked="#leaveBoard" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="/client/icons/lock-alt.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
            <Button fx:id="setPasswordButton" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#setPassword" prefHeight="30.0" prefWidth="85.0" styleClass="red-button" text="Set/Change Password">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="removePasswordButton" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#remPassword" prefHeight="30.0" prefWidth="85.0" styleClass="red-button" text="Remove Password">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <Separator prefWidth="200.0" />
            <Label maxHeight="-Infinity" minHeight="-Infinity" prefHeight="21.0" prefWidth="231.0" text="Exit options" textAlignment="CENTER">
               <font>
                  <Font name="Arial Bold" size="14.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="14.0" fitWidth="14.0" onMouseClicked="#leaveBoard" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="/client/icons/shift-left.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
            <Button maxHeight="30.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#leaveBoard" prefHeight="30.0" styleClass="red-button" text="Leave">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="deleteButton" maxHeight="30.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#deleteScreen" prefHeight="30.0" prefWidth="133.0" styleClass="red-button" text="Delete">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="12.0" fitWidth="12.0" onMouseClicked="#deleteScreen" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="/client/icons/white-trash-can.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </right>
</BorderPane>
