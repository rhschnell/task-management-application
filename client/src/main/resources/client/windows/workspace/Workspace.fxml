                  <ImageView fitHeight="14.0" fitWidth="14.0" onMouseClicked="#customizeBoard" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="/client/icons/brush.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
            <Button fx:id="renameButton" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#renameBoard" prefHeight="30.0" prefWidth="70.0" styleClass="green-button" text="Rename">
               <font>
                  <Font name="Arial Bold" size="12.0" />
