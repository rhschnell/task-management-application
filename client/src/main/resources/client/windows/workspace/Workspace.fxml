            <Button fx:id="personalizeButton" maxHeight="30.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#customizeBoard" prefHeight="30.0" styleClass="green-button" text="Personalize">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="tagsButton" maxHeight="30.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#tagOverview" prefHeight="30.0" styleClass="green-button" text="Tags">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <Separator prefWidth="200.0" />
