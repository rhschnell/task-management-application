<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>


<VBox spacing="10.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.windows.cards.edit.EditCardCtrl">
   <children>
       <TextField fx:id="cardTitle" prefHeight="25.0" prefWidth="311.0">
           <font>
             <Font name="System Bold" size="12.0" />
           </font>
       </TextField>
       <Line endX="200.0" startX="-110.0" startY="-3.814697265625E-6" stroke="#808080" />
      <HBox alignment="CENTER_LEFT" spacing="115.0">
         <children>
            <Label prefHeight="16.0" prefWidth="88.0" text="Chosen Tags">
               <font>
                  <Font name="Arial Bold" size="13.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#editTagPopup" prefHeight="26.0" prefWidth="109.0" styleClass="gray-button" text="Manage Tags" />
         </children>
      </HBox>
      <ScrollPane>
         <content>
            <VBox fx:id="appliedTagsVbox" prefHeight="74.0" prefWidth="307.0" />
         </content>
      </ScrollPane>
       <Label text="Description">
           <font>
               <Font name="Arial Bold" size="13.0" />
           </font>
       </Label>
       <TextArea fx:id="cardDescription" prefHeight="98.0" prefWidth="311.0" />
       <Label text="Task List">
           <font>
               <Font name="Arial Bold" size="13.0" />
           </font>
       </Label>
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="addTaskField" onKeyPressed="#handleKeyPressed" prefHeight="25.0" prefWidth="263.0" />
            <Button fx:id="addTaskButton" mnemonicParsing="false" onAction="#addTask" text="Add" />
         </children>
      </HBox>
      <VBox fx:id="subtasks" prefHeight="75.0" prefWidth="313.0" />
       <Line endX="200.0" startX="-110.0" startY="-3.814697265625E-6" stroke="#808080" />
       <Button fx:id="saveButton" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#save" prefHeight="23.0" prefWidth="47.0" styleClass="blue-button" text="Save">
           <font>
               <Font name="Arial Bold" size="12.0" />
           </font>
       </Button>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
