<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<VBox spacing="10.0" style="-fx-background-color: white;" stylesheets="/client/style/stylesheet.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.windows.cards.add.AddCardCtrl">
   <children>
      <HBox spacing="15.0">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <children>
            <TextField fx:id="cardTitle" maxWidth="-Infinity" prefHeight="25.0" prefWidth="310.0" promptText="Add title..." style="-fx-control-inner-background: #f0f0f0; -fx-background-radius: 10; -fx-border-color: transparent;">
               <font>
                  <Font name="Arial Bold" size="16.0" />
               </font>
            </TextField>
            <Label fx:id="errorMessage" alignment="CENTER" prefHeight="34.0" prefWidth="331.0" styleClass="error-message-label" text="Label" visible="false">
               <font>
                  <Font name="System Bold Italic" size="12.0" />
               </font></Label>
         </children>
      </HBox>
      <Separator prefWidth="200.0" />
      <HBox spacing="15.0">
         <children>
            <VBox spacing="10.0" stylesheets="/client/style/stylesheet.css">
               <children>
                  <HBox alignment="CENTER_LEFT" maxWidth="-Infinity" prefWidth="310.0">
                     <children>
                        <Label prefHeight="16.0" prefWidth="252.0" text="Tags">
                           <font>
                              <Font name="Arial Bold" size="13.0" />
                           </font>
                        </Label>
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#addTagPopup" prefHeight="12.0" prefWidth="85.0" styleClass="gray-button" text="Manage Tags">
                           <font>
                              <Font name="Arial Bold" size="11.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
                  <ScrollPane hbarPolicy="NEVER" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="75.0" prefWidth="303.0">
                     <content>
                        <VBox fx:id="appliedTagsVbox" maxHeight="1.7976931348623157E308" prefWidth="305.0" spacing="5.0" />
                     </content>
                     <VBox.margin>
                        <Insets right="-8.0" />
                     </VBox.margin>
                  </ScrollPane>
                  <Separator prefWidth="200.0" />
                  <Label text="Description">
                     <font>
                        <Font name="Arial Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextArea fx:id="cardDescription" maxHeight="135.0" maxWidth="-Infinity" minHeight="80.0" prefHeight="135.0" prefWidth="310.0" promptText="Add description..." style="-fx-control-inner-background: #f0f0f0;" wrapText="true" />
               </children>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="200.0" />
            <VBox spacing="10.0">
               <children>
                  <Label text="Task List">
                     <font>
                        <Font name="Arial Bold" size="13.0" />
                     </font>
                  </Label>
                  <HBox maxWidth="310.0" prefWidth="310.0" spacing="10.0">
                     <children>
                        <TextField fx:id="addSubtaskTitle" onKeyPressed="#handleKeyPressed" prefHeight="25.0" prefWidth="270.0" promptText="Add task..." style="-fx-background-radius: 10; -fx-control-inner-background: #f0f0f0;" />
                        <Button fx:id="addTaskButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#addTask" prefHeight="25.0" prefWidth="40.0" styleClass="green-button" text="Add">
                           <font>
                              <Font name="Arial Bold" size="11.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
                  <ScrollPane hbarPolicy="NEVER" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="231.0" prefWidth="318.0">
                     <VBox.margin>
                        <Insets right="-8.0" />
                     </VBox.margin>
                     <content>
                        <VBox prefHeight="231.0" prefWidth="301.0">
                           <children>
                              <VBox fx:id="subtasks" maxHeight="1.7976931348623157E308" prefHeight="107.0" prefWidth="301.0" spacing="10.0" />
                              <Separator prefWidth="200.0">
                                 <opaqueInsets>
                                    <Insets bottom="10.0" top="10.0" />
                                 </opaqueInsets>
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                              </Separator>
                              <HBox prefHeight="34.0" prefWidth="301.0">
                                 <children>
                                    <Label prefHeight="16.0" prefWidth="90.0" text="Color Preset:">
                                       <font>
                                          <Font name="Arial Bold" size="13.0" />
                                       </font>
                                       <opaqueInsets>
                                          <Insets />
                                       </opaqueInsets>
                                       <HBox.margin>
                                          <Insets />
                                       </HBox.margin>
                                    </Label>
                                 </children>
                              </HBox>
                              <VBox fx:id="presets" maxHeight="1.7976931348623157E308" prefHeight="107.0" prefWidth="301.0" spacing="10.0" />
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" maxWidth="-Infinity" prefWidth="310.0" spacing="10.0">
         <children>
            <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="23.0" prefWidth="87.0" styleClass="gray-button" text="Personalize">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
               <HBox.margin>
                  <Insets right="445.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="saveButton" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#save" prefHeight="23.0" prefWidth="47.0" styleClass="blue-button" text="Save">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="cancelButton" cancelButton="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#cancel" prefHeight="23.0" prefWidth="56.0" styleClass="red-button" text="Cancel">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
