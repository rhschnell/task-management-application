<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.windows.cards.add.AddCardCtrl">
   <children>
        <TextField fx:id="cardTitle" prefHeight="26.0" prefWidth="310.0" promptText="Type your card title..." style="-fx-background-insets: 0, 0 0 0 0; -fx-background-color: none; -fx-padding: 0px;">
         <font>
            <Font name="Arial Bold Italic" size="16.0" />
         </font>
      </TextField>
      <Line endX="200.0" startX="-110.0" startY="-3.814697265625E-6" stroke="#808080" />
      <HBox alignment="CENTER_LEFT" spacing="120.0">
         <children>
            <Label text="Chosen Tags">
               <font>
                  <Font name="Arial Bold" size="13.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#addTagPopup" prefHeight="26.0" prefWidth="109.0" styleClass="gray-button" text="Manage Tags" />
         </children>
      </HBox>
      <ScrollPane>
         <content>
            <VBox fx:id="appliedTagsVbox" prefHeight="74.0" prefWidth="307.0" />
         </content>
      </ScrollPane>
      <Label text="Description">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </Label>
      <TextArea fx:id="cardDescription" prefHeight="81.0" prefWidth="310.0" promptText="Type your description..." style="-fx-background-insets: 0; -fx-background-radius: 0;" wrapText="true">
         <font>
            <Font name="Arial Italic" size="12.0" />
         </font>
      </TextArea>
      <Label text="Task List">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="addSubtaskTitle" onKeyPressed="#handleKeyPressed" prefHeight="25.0" prefWidth="257.0" />
            <Button fx:id="addSubtaskButton" mnemonicParsing="false" onAction="#addTask" text="Add" />
         </children>
      </HBox>
      <VBox fx:id="subtasks" prefHeight="77.0" prefWidth="312.0" />
      <Line endX="200.0" startX="-110.0" startY="-3.814697265625E-6" stroke="#808080" />
      <HBox alignment="CENTER_LEFT" spacing="100.0">
         <children>
            <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#save" prefHeight="23.0" prefWidth="87.0" styleClass="gray-button" text="Personalize">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="saveButton" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#save" prefHeight="23.0" prefWidth="47.0" styleClass="blue-button" text="Save">
                     <font>
                        <Font name="Arial Bold" size="12.0" />
                     </font>
                  </Button>
                  <Button fx:id="cancelButton" cancelButton="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#cancel" prefHeight="23.0" prefWidth="56.0" styleClass="red-button" text="Cancel">
                     <font>
                        <Font name="Arial Bold" size="12.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
