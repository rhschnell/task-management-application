<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<VBox spacing="10.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.windows.cards.view.ViewCardCtrl">
   <children>
      <Label fx:id="cardTitle" text="Label">
         <font>
            <Font name="Arial Bold" size="16.0" />
         </font>
      </Label>
      <Line endX="200.0" startX="-110.0" startY="-3.814697265625E-6" stroke="#808080" />
      <HBox prefHeight="15.0" prefWidth="59.0" spacing="10.0" />
      <Label text="Chosen Tags">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </Label>
      <ScrollPane>
         <content>
            <VBox fx:id="appliedTagsVbox" prefHeight="74.0" prefWidth="307.0" />
         </content>
      </ScrollPane>
      <Label text="Description">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </Label>
      <Text fx:id="cardDescription" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" wrappingWidth="182.28271484375">
         <font>
            <Font name="Arial" size="12.0" />
         </font>
      </Text>
      <Label text="Task List">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </Label>
      <VBox fx:id="taskBox" prefHeight="83.0" prefWidth="312.0" />
      <Line endX="200.0" startX="-110.0" startY="-3.814697265625E-6" stroke="#808080" />
      <HBox spacing="15.0">
         <children>
            <Button fx:id="editButton" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#edit" prefHeight="23.0" prefWidth="47.0" styleClass="blue-button" text="Edit">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="deleteButton" cancelButton="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#delete" prefHeight="23.0" prefWidth="56.0" styleClass="red-button" text="Delete">
               <font>
                  <Font name="Arial Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
