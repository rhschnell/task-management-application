<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml/1" prefHeight="200.0" prefWidth="310.0" spacing="10.0"
      style="-fx-background-color: white;" stylesheets="/client/style/stylesheet.css" xmlns="http://javafx.com/javafx/19"
      fx:controller="client.windows.tags.view.TagOverviewCtrl">
    <children>
        <Label fx:id="cardTitle" text="Tags">
            <font>
                <Font name="Arial Bold" size="13.0"/>
            </font>
        </Label>
        <ScrollPane prefHeight="150.0" prefWidth="336.0">
            <content>
                <VBox fx:id="displayedTags" maxHeight="1.7976931348623157E308" prefHeight="1.0" prefWidth="290.0"
                      spacing="10.0"/>
            </content>
            <VBox.margin>
                <Insets right="-8.0"/>
            </VBox.margin>
        </ScrollPane>
        <Separator prefWidth="200.0"/>
        <HBox prefHeight="14.0" prefWidth="290.0">
            <children>
                <Button fx:id="addTagButton" cancelButton="true" maxHeight="-Infinity" maxWidth="-Infinity"
                        minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#addTag"
                        prefHeight="25.0" prefWidth="89.0" styleClass="blue-button"
                        stylesheets="/client/style/stylesheet.css" text="Add new tag">
                    <font>
                        <Font name="Arial Bold" size="12.0"/>
                    </font>
                    <HBox.margin>
                        <Insets right="140.0"/>
                    </HBox.margin>
                </Button>
                <Button fx:id="closeButton" cancelButton="true" maxHeight="-Infinity" maxWidth="-Infinity"
                        minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#close"
                        prefHeight="25.0" prefWidth="60.0" styleClass="red-button" text="Close">
                    <font>
                        <Font name="Arial Bold" size="12.0"/>
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>
