<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="10.0" style="-fx-background-color: white;"
      stylesheets="/client/style/stylesheet.css" xmlns="http://javafx.com/javafx/19"
      fx:controller="client.windows.tags.edit.EditTagCtrl">
    <children>
        <TextField fx:id="tagTitle" maxWidth="-Infinity" onKeyPressed="#saveOnEnter" prefHeight="5.0" prefWidth="312.0"
                   promptText="Type tag name..."
                   style="-fx-control-inner-background: #f0f0f0; -fx-background-radius: 10; -fx-border-color: transparent;">
            <font>
                <Font name="Arial Bold" size="12.0"/>
            </font>
        </TextField>
        <Separator prefWidth="200.0"/>
        <HBox prefWidth="312.0" spacing="20.0">
            <children>
                <VBox prefWidth="151.0" spacing="10.0">
                    <children>
                        <Label text="Tag color">
                            <font>
                                <Font name="Arial Bold" size="13.0"/>
                            </font>
                        </Label>
                        <ColorPicker fx:id="tagColor" prefWidth="137.0" style="-fx-background-radius: 10;"/>
                    </children>
                </VBox>
                <VBox prefWidth="144.0" spacing="10.0">
                    <children>
                        <Label text="Font color">
                            <font>
                                <Font name="Arial Bold" size="13.0"/>
                            </font>
                        </Label>
                        <ColorPicker fx:id="fontColor" prefWidth="146.0" style="-fx-background-radius: 10;">
                            <value>
                                <Color/>
                            </value>
                        </ColorPicker>
                    </children>
                </VBox>
            </children>
        </HBox>
        <Separator prefWidth="200.0"/>
        <HBox prefHeight="0.0" prefWidth="310.0">
            <children>
                <Button fx:id="saveButton" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
                        minWidth="-Infinity" mnemonicParsing="false" onAction="#save" prefHeight="23.0" prefWidth="71.0"
                        styleClass="blue-button" text="Save">
                    <font>
                        <Font name="Arial Bold" size="12.0"/>
                    </font>
                    <HBox.margin>
                        <Insets right="185.0"/>
                    </HBox.margin>
                </Button>
                <Button fx:id="cancelButton" cancelButton="true" maxHeight="-Infinity" maxWidth="-Infinity"
                        minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#cancel"
                        prefHeight="23.0" prefWidth="56.0" styleClass="red-button" text="Cancel">
                    <font>
                        <Font name="Arial Bold" size="12.0"/>
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>
